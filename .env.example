# Copy to .env (never commit .env). Paper mode (default) needs none of the HL_* keys.

# Signing key (64 hex, with or without 0x): a Hyperliquid API/agent wallet key
# (More > API in the UI), not your main wallet key. Mainnet refuses a main wallet key.
# Only read in testnet / mainnet modes. Never logged.
HL_PRIVATE_KEY=
# Main account address (0x + 40 hex) when HL_PRIVATE_KEY is an API/agent wallet.
# Required on mainnet. On testnet, leave empty to use the address derived from HL_PRIVATE_KEY.
HL_ACCOUNT_ADDRESS=

# Telegram alerts (optional; alerts are disabled with a log line if unset).
# Entries, exits, kill switch, warnings / errors, startup / shutdown, daily summary.
TELEGRAM_BOT_TOKEN=
# Read-only commands /pnl, /trades, /help are answered only in a private chat whose id
# is this value (your user id, positive); with a group id only alerts work.
TELEGRAM_CHAT_ID=
# Optional Bot API base URL override (default https://api.telegram.org; used for local tests).
TELEGRAM_API_BASE=

# Mainnet guard (REAL FUNDS): mainnet requires --mode mainnet --mainnet AND exactly
# the value yes-i-understand, plus HL_PRIVATE_KEY and HL_ACCOUNT_ADDRESS above.
# Leave empty here; for mainnet use a separate env file (see README,
# "Running on mainnet (real funds)").
ANTBOT_CONFIRM_MAINNET=

# Log filter (tracing EnvFilter syntax). An invalid value falls back to info
# with a warning. For debug logs of the bot itself: RUST_LOG=info,antbot=debug
RUST_LOG=info

# Config file (same as -c; default config/default.toml, /app/config/default.toml
# in Docker). E.g. a git-ignored local config:
# ANTBOT_CONFIG=config/local.toml
# Data dir override (same as --data-dir; default monitor.data_dir, /data in
# Docker). Use a separate one per mode and per coin, e.g. for testnet in Docker:
# ANTBOT_DATA_DIR=/data/testnet

# docker compose only: uid / gid the container runs as. It must own ./data
# (default 10001:10001, the image's antbot user). E.g. ANTBOT_UID=1000.
ANTBOT_UID=
ANTBOT_GID=
