# antbot strategy stack: NON-SECRET settings only. root:root 0600.
#
# Never put a key, token or chat id here: they are files in ./secrets/
# (10001:10001 0400), mounted at /run/secrets/<name>. Only their paths are
# set below. compose.yaml passes an explicit list of variables to the
# container, so anything else in this file never reaches the bot.

# Compose project (same as `docker compose -p antbot-<name>`).
COMPOSE_PROJECT_NAME=antbot-__NAME__
# Container name suffix, Telegram header and /metrics instance label.
ANTBOT_INSTANCE_NAME=__NAME__
# Image tag: latest or a git short SHA (`docker images antbot`).
ANTBOT_TAG=latest
RUST_LOG=info
# Optional Telegram header override (default "[<instance> <mode> <coin>]").
# ANTBOT_TELEGRAM_PREFIX=

# Telegram alerts. Unset both lines to disable alerts; a set line with an
# empty secret file is a startup error.
TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram_bot_token
TELEGRAM_CHAT_ID_FILE=/run/secrets/telegram_chat_id
# Optional Bot API base URL (tests only; default https://api.telegram.org).
# TELEGRAM_API_BASE=

# Testnet / mainnet only: API wallet key and the account it trades for.
#HL_PRIVATE_KEY_FILE=/run/secrets/hl_private_key
#HL_ACCOUNT_ADDRESS_FILE=/run/secrets/hl_account_address
# Optional sub-account / vault (or [live].vault_address in config.toml).
#HL_VAULT_ADDRESS_FILE=/run/secrets/hl_vault_address

# Mainnet only (REAL FUNDS). Both are required on top of mode = "mainnet" in
# config.toml; see "Running on mainnet" in the repo README for the exact
# confirmation value. Never set them for paper or testnet.
#ANTBOT_MAINNET_FLAG=--mainnet
#ANTBOT_CONFIRM_MAINNET=
